# Microsoft Bot Framework Credentials
MICROSOFT_APP_ID=""
MICROSOFT_APP_PASSWORD=""

# API Keys & Tokens
GITHUB_TOKEN=""               # Required for GitHub commands (fine-grained PAT recommended)
JIRA_SERVER="https://<your-domain>.atlassian.net" # Required for Jira integration
JIRA_USERNAME="<your-email@example.com>"         # Required for Jira integration
JIRA_API_TOKEN=""             # Required for Jira integration (create one in Atlassian account settings)
GEMINI_API_KEY=""             # Required for LLM processing

# -- Tool Keys --
OCTOPUS_SERVER="https://<your-octopus-url>" # Required for Octopus Deploy integration
OCTOPUS_API_KEY="API-XXXXXXXXXXXXXXXXXXXXXX" # Required for Octopus Deploy integration
PERPLEXITY_API_KEY=""         # Required for Perplexity AI search

# Bot Configuration
BOT_BASE_URL="http://localhost:8000" # Ngrok URL when running locally (e.g., https://<your-ngrok-id>.ngrok.io). Port changed to 8000.

# Optional: Specify target repositories/projects/spaces if not provided as args or inferred
DEFAULT_GITHUB_REPO="<your-org>/<your-repo>" # Example: "octocat/Spoon-Knife"
DEFAULT_JIRA_PROJECT_KEY="PROJ"             # Example: JIRA project key for feedback/cherry-pick
DEFAULT_OCTOPUS_SPACE_NAME="Default"        # Example: Octopus Space Name
DEFAULT_OCTOPUS_PROJECT_NAME="MyWebApp"     # Example: Octopus Project Name
DEFAULT_OCTOPUS_ENVIRONMENT_NAME="Production" # Example: Octopus Environment Name

# Optional: Redis Configuration (leave blank to use in-memory store)
REDIS_URL=""                  # Example: "redis://localhost:6379/0" or Redis Cloud URL

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"
AUDIT_LOG_FILE="logs/audit.log" # Path for audit log

# --- Security Settings ---
# RBAC - Set to 'true' to enable. Requires AAD Group IDs below.
RBAC_ENABLED="false"
# Comma-separated AAD Group Object IDs
RBAC_DEPLOY_GROUPS="" # e.g., "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee,ffffffff-..."
RBAC_ADMIN_GROUPS="" # Groups allowed for potential future admin commands

# Rate Limiting (slowapi format: "requests/period")
RATE_LIMIT_USER_DEFAULT="100/minute" # Applied *inside* bot logic if user ID known
RATE_LIMIT_IP_DEFAULT="500/minute" # Applied by middleware based on IP
RATE_LIMIT_DEPLOY="5/minute" # Example specific limit for deployment tool
RATE_LIMIT_PERPLEXITY="30/minute" # Example specific limit

# --- Feature Settings ---

# Webhooks (Generate strong random secrets)
GITHUB_WEBHOOK_SECRET=""     # Secret used to verify GitHub webhook payloads
OCTOPUS_WEBHOOK_SECRET=""    # Secret used to verify Octopus webhook payloads (if using HMAC)

# Proactive Messaging & Digests
DEFAULT_USER_TIMEZONE="UTC"  # Fallback timezone (e.g., "America/New_York", "Europe/London")

# Webhook Target Mapping (Example: Comma-separated key:channel_id pairs)
# Teams Channel ID format: 19:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@thread.tacv2
# User ID format for DMs: 29:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO_CHANNEL_MAP=""   # e.g., "myorg/repo1:19:abc...@thread.tacv2,myorg/repo2:29:user_id_xyz..."
OCTOPUS_PROJECT_CHANNEL_MAP="" # e.g., "Projects-123:19:abc...@thread.tacv2"

# Suggest Command (Optional - limits internal API calls)
SUGGEST_MAX_PRS_TO_CHECK=5
SUGGEST_MAX_JIRA_TO_CHECK=5

# MS Graph API (Needed for reliable user group checks in RBAC & finding users/channels)
# Requires an Azure AD App Registration with appropriate Graph permissions
# --- THESE ARE REQUIRED FOR RBAC_ENABLED=true ---
MSGRAPH_TENANT_ID="YOUR_AZURE_TENANT_ID" # Your Azure AD Tenant ID
MSGRAPH_CLIENT_ID="YOUR_AZURE_APP_CLIENT_ID" # Client ID of the AAD App Registration (often same as MICROSOFT_APP_ID)
MSGRAPH_CLIENT_SECRET="YOUR_AZURE_APP_CLIENT_SECRET" # Client Secret of the AAD App Registration (often same as MICROSOFT_APP_PASSWORD)

# ==============================================================================
# Microsoft Teams / Bot Framework Settings
# ==============================================================================
MICROSOFT_APP_TYPE="MultiTenant" # Or "SingleTenant"
MICROSOFT_APP_ID="YOUR_MICROSOFT_APP_ID" # Your Bot application's Microsoft App ID
MICROSOFT_APP_PASSWORD="YOUR_MICROSOFT_APP_PASSWORD" # Your Bot application's secret

# ==============================================================================
# Azure AD Settings (for RBAC via Graph API)
# ==============================================================================
AZURE_TENANT_ID="YOUR_AZURE_TENANT_ID" # Your Azure AD Tenant ID
AZURE_CLIENT_ID="YOUR_AZURE_APP_CLIENT_ID" # Client ID of the AAD App Registration used for Graph API access
AZURE_CLIENT_SECRET="YOUR_AZURE_APP_CLIENT_SECRET" # Client Secret of the AAD App Registration

# ==============================================================================
# RBAC Configuration (Group IDs)
# ==============================================================================
# Define which AAD Group Object IDs grant permission for specific actions.
# Example: Users in the "Deployments" group can trigger Octopus deployments.
RBAC_DEPLOYMENTS_GROUP_ID="YOUR_AAD_DEPLOYMENTS_GROUP_OBJECT_ID"
RBAC_ADMIN_GROUP_ID="YOUR_AAD_ADMIN_GROUP_OBJECT_ID"
# Add more group IDs as needed for different permission levels

# ==============================================================================
# Backend API Endpoint
# ==============================================================================
# The base URL where your bot is hosted. Used for proactive messages, etc.
# Example: "https://your-bot-app-service.azurewebsites.net"
BOT_ENDPOINT="http://localhost:3978" # Adjust for deployment
BOT_API_MESSAGES_ENDPOINT="/api/messages"
BOT_API_HEALTHCHECK_ENDPOINT="/api/healthz"
BOT_API_WEBHOOK_ENDPOINT="/api/webhooks/"

# ==============================================================================
# LLM Configuration (Example: Google Gemini)
# ==============================================================================
# Replace with your chosen LLM provider's configuration
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# GEMINI_MODEL_NAME="gemini-1.5-flash" # Or other appropriate model

# ==============================================================================
# Memory Store (Example: Redis)
# ==============================================================================
MEMORY_TYPE="redis" # Or "memory" for in-memory (not for production)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=null # Set if your Redis instance requires a password
REDIS_DB=0
REDIS_SSL=false # Set to true if connecting to Redis over SSL

# ==============================================================================
# External Service Integrations (Example Placeholders)
# ==============================================================================
# GitHub
GITHUB_TOKEN="YOUR_GITHUB_PAT"
# GITHUB_WEBHOOK_SECRET="YOUR_GITHUB_WEBHOOK_SECRET"

# Jira
JIRA_SERVER="https://your-domain.atlassian.net"
JIRA_USERNAME="your-jira-bot-email@example.com"
JIRA_API_TOKEN="YOUR_JIRA_API_TOKEN"

# Octopus Deploy
OCTOPUS_SERVER_URL="https://your.octopus.app"
OCTOPUS_API_KEY="YOUR_OCTOPUS_API_KEY"
# OCTOPUS_WEBHOOK_SECRET="YOUR_OCTOPUS_WEBHOOK_SECRET"

# Perplexity AI (Example)
# PERPLEXITY_API_KEY="YOUR_PERPLEXITY_API_KEY"

# ==============================================================================
# Logging Configuration
# ==============================================================================
# LOG_FORMAT="json" # Or "console"

# ==============================================================================
# Feature Flags / Settings
# ==============================================================================
# DAILY_DIGEST_ENABLED=true
# DAILY_DIGEST_TIME_UTC="08:00"

# ==============================================================================
# Security / Rate Limiting
# ==============================================================================
# API_KEY_FOR_WEBHOOKS="A_SECURE_RANDOM_STRING_FOR_WEBHOOK_AUTH" # If using API key auth for webhooks
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_USER="50/minute"
# RATE_LIMIT_WEBHOOK="100/minute" 